# ---------- LLM (optional: everything has a deterministic fallback) ----------
# anthropic | sarvam | none  (the other provider is tried next if its key is set)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Model for live conversation turns (defaults to ANTHROPIC_MODEL). Effort: low = fastest replies.
ANTHROPIC_CHAT_MODEL=
ANTHROPIC_CHAT_EFFORT=low
ANTHROPIC_EVAL_EFFORT=medium

# ---------- Postgres ----------
# Local dev (docker compose postgres): leave as is.
# Supabase: Project Settings -> Database -> Connection string (URI, "Session pooler", port 5432).
DATABASE_URL=postgresql://guru:guru@localhost:54322/guruline
# Server-side only. Not used by the browser. Kept for parity with agent.md.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------- FalkorDB ----------
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# ---------- Bolna ----------
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# Rahul's phone for live demo calls (must be verified on a Bolna trial account)
DEMO_STUDENT_PHONE=
BOLNA_FROM_NUMBER=
WEBHOOK_SECRET=change-me
PUBLIC_BASE_URL=https://api.yourdomain.com

# ---------- Sarvam AI (fallback voice channel + optional LLM) ----------
# https://dashboard.sarvam.ai -> API keys. Used when Bolna is out of credit / rate-limited / down:
# the student gets a browser call link (/call?t=...) -> Sarvam STT -> tutor -> Sarvam TTS.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_LLM_MODEL=sarvam-105b-conversations

# ---------- Voice routing ----------
# auto = Bolna phone call first, Sarvam web call when Bolna hits a limit | bolna = Bolna only | sarvam = web call only
VOICE_PROVIDER=auto
# After a Bolna limit error, skip Bolna for this long (POST /voice/reset_bolna after a top-up)
BOLNA_COOLDOWN_MINUTES=60
WEB_CALL_LINK_MINUTES=60

# ---------- App ----------
DEMO_MODE=true
# Required by the API for dashboard/admin routes. The web server injects it; the browser never sees it.
ADMIN_KEY=change-me-admin
API_INTERNAL_URL=http://localhost:8000

# ---------- Web (browser-visible; anon key ONLY, never the service key) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEMO_PHONE=+91 80000 00000
# Optional basic-auth password for the dashboard (user: guru)
DASHBOARD_PASSWORD=

# ---------- Prod (Caddy) ----------
API_DOMAIN=api.yourdomain.com
WEB_DOMAIN=app.yourdomain.com
